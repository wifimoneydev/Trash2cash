# Copy this file to .env and fill in your own key.
# .env is gitignored — never commit a real key.

# Optional. If unset (or invalid/unreachable), Trash2Cash automatically
# falls back to the local Naive Bayes chatbot — the app runs fine without this.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini
